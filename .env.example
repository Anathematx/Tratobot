# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Ваш Telegram ID (узнать у @userinfobot). Через запятую, если пользователей несколько.
# Оставьте пустым, чтобы бот отвечал всем (не рекомендуется).
ALLOWED_USERS=
# Часовой пояс
TZ_NAME=Europe/Moscow
# Дни выплат зарплаты и аванса. Пусто — бот определит по истории поступлений.
PAYDAYS=5,20
# Еженедельный отчёт: день недели (mon..sun) и час
REPORT_DAY=mon
REPORT_HOUR=9
# Утренний свод трат за вчерашний день: час
DAILY_HOUR=9
# Через сколько минут удалять сообщения из чата (0 — не удалять).
# Сводки, отчёты и напоминания о платежах не удаляются.
AUTODELETE_MINUTES=30
# Ежедневная проверка плановых платежей: час и за сколько дней предупреждать
REMINDER_HOUR=10
REMIND_DAYS_BEFORE=2
